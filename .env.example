# Helper 0.2.9 usa pnpm/Corepack para comandos locais. Docker nao e necessario.

# Database
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
DATABASE_TIMEOUT_MS="8000"

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# First admin bootstrap / seed
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_DISPLAY_NAME="Administrador"
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_SECRET="generate-another-secret"

# Vercel Cron authentication
CRON_SECRET="generate-another-secret"

# Integration hub (n8n, internal workers and service-to-service API)
INTEGRATION_API_SECRET="generate-a-dedicated-random-secret"

# Todoist (personal cockpit; Helper remains the source of truth)
TODOIST_API_TOKEN=""
TODOIST_CLIENT_SECRET=""
TODOIST_PROJECT_ID=""
TODOIST_SYNC_AREAS="MKT"
TODOIST_SYNC_ASSIGNEE_USERNAME=""

# Postiz callback. Do not reuse the integration or cron secrets.
POSTIZ_WEBHOOK_SECRET=""

# Email notifications
# The app keeps saving tickets even when email is not configured.

# Gmail SMTP with a Google app password.
GMAIL_USER="your.account@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# General recipients: MKT, PF, and fallback for any area.
NOTIFICATION_TO_EMAILS="person1@example.com,person2@example.com"

# TI-specific recipients. If empty, TI falls back to NOTIFICATION_TO_EMAILS.
NOTIFICATION_TI_EMAILS="ti1@example.com,ti2@example.com"

EMAIL_TIMEOUT_MS="6000"

# PWA Web Push
# Generate with: pnpm web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
